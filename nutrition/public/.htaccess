# Front-controller для Apache: всё, что не реальный файл, уходит в index.php.
DirectoryIndex index.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Существующие файлы и папки (css, js, иконки, landing.html, app/) — отдаём как есть
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Всё остальное (/, /api/*, SPA-маршруты) — во front-controller
  RewriteRule ^ index.php [L]
</IfModule>

# Кэш статики (необязательно)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType text/css "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 hour"
</IfModule>
