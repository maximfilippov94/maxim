# Front-controller для Apache. Минимальный набор для shared-хостинга.
Options +FollowSymLinks
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Существующие файлы и папки (css, js, иконки, landing.html, app/) — как есть
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Всё остальное (/, /api/*, SPA-маршруты) — во front-controller
  RewriteRule ^ index.php [L]
</IfModule>
