# ==========================================================================
# Запасной вариант, ЕСЛИ корень сайта нельзя переключить на подпапку public/
# и вы залили содержимое nutrition/ прямо в корень домена.
#
# РЕКОМЕНДУЕТСЯ вместо этого указать «Каталог сайта» = .../public
# (тогда этот файл не нужен — работает только public/.htaccess).
# ==========================================================================
Options +FollowSymLinks

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Защита от петли: если путь уже внутри public/ — больше не переписываем
  RewriteRule ^public/ - [L]

  # Закрываем прямой доступ к внутренностям приложения
  RewriteRule ^(src|bin|migrations|seeds|data)(/|$) - [F]
  RewriteRule (^|/)config\.php - [F]

  # Всё внутрь public/ (единая точка входа)
  RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
